nt-style: normal; font-display: swap; }\n@font-face { font-family: 'Inter'; src: url(\"c86b0b98-54e7-4f9b-afe5-ce33febe882e\")       format('truetype'); font-weight: 700; font-style: italic; font-display: swap; }\n@font-face { font-family: 'Inter'; src: url(\"e4282a1a-3d7f-49ea-8c6f-e7df03e429e0\")        format('truetype'); font-weight: 800; font-style: normal; font-display: swap; }\n@font-face { font-family: 'Inter'; src: url(\"c18547f5-1003-4c23-a035-0fa2965c8ca7\")  format('truetype'); font-weight: 800; font-style: italic; font-display: swap; }\n@font-face { font-family: 'Inter'; src: url(\"a93fc41d-b54b-4512-b42c-19770bf7450b\")            format('truetype'); font-weight: 900; font-style: normal; font-display: swap; }\n@font-face { font-family: 'Inter'; src: url(\"f351d1f6-c697-4270-ad38-ee37671a783c\")      format('truetype'); font-weight: 900; font-style: italic; font-display: swap; }\n\n/* ---- Inter Display (24pt optical size) — use for 24 – 40px type ---- */\n@font-face { font-family: 'Inter Display'; src: url(\"3a038ae2-0bb2-4884-9e6a-9ba8040eb70c\")  format('truetype'); font-weight: 400; font-style: normal; font-display: swap; }\n@font-face { font-family: 'Inter Display'; src: url(\"1f860059-da02-4f1f-a9ec-fb18cedc27c6\")   format('truetype'); font-weight: 500; font-style: normal; font-display: swap; }\n@font-face { font-family: 'Inter Display'; src: url(\"6c8fc869-d6eb-4de6-bf54-0418e13a4fa7\") format('truetype'); font-weight: 600; font-style: normal; font-display: swap; }\n@font-face { font-family: 'Inter Display'; src: url(\"428d04dd-2cdc-4d9e-9377-fea0d7a0d8f6\")     format('truetype'); font-weight: 700; font-style: normal; font-display: swap; }\n@font-face { font-family: 'Inter Display'; src: url(\"80253327-9405-45f2-8bff-4723b90fa1d1\")format('truetype'); font-weight: 800; font-style: normal; font-display: swap; }\n\n/* ---- Inter Display Large (28pt optical size) — hero display ---- */\n@font-face { font-family: 'Inter Display Lg'; src: url(\"2ba21045-0681-461a-b339-11d86b635514\") format('truetype'); font-weight: 600; font-style: normal; font-display: swap; }\n@font-face { font-family: 'Inter Display Lg'; src: url(\"6fb60deb-a3f9-413b-8356-9d2b9fe7ca52\")     format('truetype'); font-weight: 700; font-style: normal; font-display: swap; }\n@font-face { font-family: 'Inter Display Lg'; src: url(\"12b89059-c791-48d1-9afe-5b6b46dd9127\")format('truetype'); font-weight: 800; font-style: normal; font-display: swap; }\n@font-face { font-family: 'Inter Display Lg'; src: url(\"c0656992-bfbb-4704-8544-1c4bae5a6f96\")    format('truetype'); font-weight: 900; font-style: normal; font-display: swap; }\n\n/* ================================================================\n   TOKENS\n   ================================================================ */\n:root {\n  /* ---------- Brand palette (from guidelines) ---------- */\n  --lutra-navy:       #001f54;   /* primary 1 — core brand */\n  --lutra-blue:       #2c48ed;   /* primary 2 — accent / action */\n  --lutra-teal:       #01c7a9;   /* primary 3 — signal / success */\n  --lutra-lilac:      #eeedf4;   /* primary 4 — neutral surface */\n  --lutra-black:      #000000;\n\n  /* ---------- Secondary / tints (from guidelines) ---------- */\n  --lutra-blue-400:   #7c95f7;\n  --lutra-blue-200:   #c0d7ff;\n  --lutra-blue-100:   #e6eefe;\n\n  /* ---------- Extended neutrals (derived from navy) ---------- */\n  --lutra-ink:        #001f54;\n  --lutra-ink-80:     #334b76;\n  --lutra-ink-60:     #667898;\n  --lutra-ink-40:     #99a5ba;\n  --lutra-ink-20:     #ccd2dc;\n  --lutra-ink-10:     #e6e9ee;\n  --lutra-ink-05:     #f3f4f7;\n  --lutra-paper:      #ffffff;\n  --lutra-bone:       #fafafb;\n\n  /* ---------- Semantic — foreground ---------- */\n  --fg-1:             var(--lutra-navy);     /* headings, primary copy */\n  --fg-2:             #334b76;               /* body copy on light bg */\n  --fg-3:             #667898;               /* secondary / muted */\n  --fg-4:             #99a5ba;               /* tertiary / placeholder */\n  --fg-inverse:       #ffffff;\n  --fg-brand:         var(--lutra-blue);\n  --fg-accent:        var(--lutra-teal);\n\n  /* ---------- Semantic — background ---------- */\n  --bg-1:             #ffffff;\n  --bg-2:             var(--lutra-bone);\n  --bg-3:             var(--lutra-lilac);\n  --bg-4:             var(--lutra-ink-05);\n  --bg-brand:         var(--lutra-navy);\n  --bg-brand-soft:    var(--lutra-blue-100);\n  --bg-accent:        var(--lutra-blue);\n  --bg-accent-soft:   var(--lutra-blue-200);\n  --bg-signal:        var(--lutra-teal);\n\n  /* ---------- Semantic — border ---------- */\n  --border-1:         var(--lutra-ink-10);   /* default hairline */\n  --border-2:         var(--lutra-ink-20);   /* stronger */\n  --border-brand:     var(--lutra-navy);\n  --border-focus:     var(--lutra-blue);\n\n  /* ---------- Semantic — state ---------- */\n  --success:          var(--lutra-teal);\n  --success-soft:     #d4f5ee;\n  --info:             var(--lutra-blue);\n  --info-soft:        var(--lutra-blue-100);\n  --warning:          #f5a524;\n  --warning-soft:     #fef3d9;\n  --danger:           #e5484d;\n  --danger-soft:      #fde8e8;\n\n  /* ---------- Type families ---------- */\n  --font-display:     'Manrope', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;\n  --font-body:        'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;\n  --font-mono:        ui-monospace, 'SF Mono', Menlo, Consolas, monospace;\n\n  /* ---------- Type scale (fluid-ready, fixed px baselines) ---------- */\n  --fs-display-2xl:   84px;  /* hero */\n  --fs-display-xl:    64px;\n  --fs-display-lg:    52px;\n  --fs-h1:            44px;\n  --fs-h2:            34px;\n  --fs-h3:            26px;\n  --fs-h4:            20px;\n  --fs-h5:            17px;\n  --fs-body-lg:       18px;\n  --fs-body:          16px;\n  --fs-body-sm:       14px;\n  --fs-caption:       13px;\n  --fs-micro:         11px;   /* eyebrows, labels */\n\n  /* ---------- Line heights ---------- */\n  --lh-tight:         1.05;   /* @kind font */\n  --lh-snug:          1.15;   /* @kind font */\n  --lh-heading:       1.2;    /* @kind font */\n  --lh-body:          1.55;   /* @kind font */\n  --lh-loose:         1.75;   /* @kind font */\n\n  /* ---------- Letter spacing ---------- */\n  --ls-tight:         -0.02em; /* @kind font */\n  --ls-snug:          -0.01em; /* @kind font */\n  --ls-normal:        0;       /* @kind font */\n  --ls-wide:          0.02em;  /* @kind font */\n  --ls-eyebrow:       0.14em;  /* @kind font */\n\n  /* ---------- Font weights ---------- */\n  --fw-light:         300;   /* @kind font */\n  --fw-regular:       400;   /* @kind font */\n  --fw-medium:        500;   /* @kind font */\n  --fw-semibold:      600;   /* @kind font */\n  --fw-bold:          700;   /* @kind font */\n  --fw-extrabold:     800;   /* @kind font */\n  --fw-black:         900;   /* @kind font */\n\n  /* ---------- Spacing (4px base) ---------- */\n  --space-0:   0;\n  --space-1:   4px;\n  --space-2:   8px;\n  --space-3:   12px;\n  --space-4:   16px;\n  --space-5:   20px;\n  --space-6:   24px;\n  --space-8:   32px;\n  --space-10:  40px;\n  --space-12:  48px;\n  --space-16:  64px;\n  --space-20:  80px;\n  --space-24:  96px;\n  --space-32:  128px;\n\n  /* ---------- Radii ---------- */\n  --radius-xs:  4px;\n  --radius-sm:  8px;\n  --radius-md:  12px;\n  --radius-lg:  16px;\n  --radius-xl:  24px;\n  --radius-2xl: 32px;\n  --radius-pill: 999px;\n\n  /* ---------- Elevation / shadow ---------- */\n  --shadow-xs:  0 1px 2px rgba(0, 31, 84, 0.06);\n  --shadow-sm:  0 2px 4px rgba(0, 31, 84, 0.06), 0 1px 2px rgba(0, 31, 84, 0.04);\n  --shadow-md:  0 8px 20px -8px rgba(0, 31, 84, 0.12), 0 2px 6px rgba(0, 31, 84, 0.06);\n  --shadow-lg:  0 20px 40px -12px rgba(0, 31, 84, 0.18), 0 4px 10px rgba(0, 31, 84, 0.06);\n  --shadow-xl:  0 32px 64px -16px rgba(0, 31, 84, 0.22);\n  --shadow-brand: 0 12px 28px -8px rgba(44, 72, 237, 0.35);\n\n  /* ---------- Focus ring ---------- */\n  --ring:      0 0 0 3px rgba(44, 72, 237, 0.25); /* @kind shadow */\n\n  /* ---------- Motion ---------- */\n  --ease-out:    cubic-bezier(0.22, 0.61, 0.36, 1); /* @kind other */\n  --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);    /* @kind other */\n  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);  /* @kind other */\n  --dur-fast:    120ms; /* @kind other */\n  --dur-base:    200ms; /* @kind other */\n  --dur-slow:    320ms; /* @kind other */\n\n  /* ---------- Layout ---------- */\n  --container:      1200px; /* @kind other */\n  --container-wide: 1360px; /* @kind other */\n  --gutter:         24px;   /* @kind spacing */\n}\n\n/* ================================================================\n   BASELINE — semantic element styles\n   ================================================================ */\nhtml, body {\n  font-family: var(--font-body);\n  font-size: var(--fs-body);\n  line-height: var(--lh-body);\n  color: var(--fg-2);\n  background: var(--bg-1);\n  -webkit-font-smoothing: antialiased;\n  text-rendering: optimizeLegibility;\n}\n\nh1, h2, h3, h4, h5, h6 {\n  font-family: var(--font-display);\n  color: var(--fg-1);\n  line-height: var(--lh-heading);\n  letter-spacing: var(--ls-snug);\n  font-weight: var(--fw-bold);\n  margin: 0;\n  text-wrap: balance;\n}\n\nh1 {\n  font-size: var(--fs-h1);\n  font-weight: var(--fw-extrabold);\n  letter-spacing: var(--ls-tight);\n  line-height: var(--lh-snug);\n}\nh2 { font-size: var(--fs-h2); font-weight: var(--fw-bold); letter-spacing: var(--ls-tight); }\nh3 { font-size: var(--fs-h3); font-weight: var(--fw-bold); }\nh4 { font-size: var(--fs-h4); font-weight: var(--fw-semibold); }\nh5 { font-size: var(--fs-h5); font-weight: var(--fw-semibold); }\n\n.display-2xl { font-family: var(--font-display); font-size: var(--fs-display-2xl); font-weight: var(--fw-extrabold); line-height: var(--lh-tight); letter-spacing: -0.03em; color: var(--fg-1); }\n.display-xl  { font-family: var(--font-display); font-size: var(--fs-display-xl);  font-weight: var(--fw-extrabold); line-height: var(--lh-tight); letter-spacing: -0.025em; color: var(--fg-1); }\n.display-lg  { font-family: var(--font-display); font-size: var(--fs-display-lg);  font-weight: var(--fw-bold);      line-height: var(--lh-snug); letter-spacing: var(--ls-tight); color: var(--fg-1); }\n\np { margin: 0 0 1em; text-wrap: pretty; }\n.lead      { font-size: var(--fs-body-lg); color: var(--fg-2); line-height: var(--lh-body); }\n.body-sm   { font-size: var(--fs-body-sm); }\n.caption   { font-size: var(--fs-caption); color: var(--fg-3); }\n.eyebrow {\n  font-family: var(--font-display);\n  font-size: var(--fs-micro);\n  font-weight: var(--fw-bold);\n  letter-spacing: var(--ls-eyebrow);\n  text-transform: uppercase;\n  color: var(--fg-brand);\n}\n\ncode, .mono {\n  font-family: var(--font-mono);\n  font-size: 0.92em;\n  background: var(--bg-4);\n  padding: 0.12em 0.4em;\n  border-radius: var(--radius-xs);\n}\n\na {\n  color: var(--fg-brand);\n  text-decoration: none;\n  transition: color var(--dur-fast) var(--ease-out);\n}\na:hover { color: var(--lutra-navy); text-decoration: underline; text-underline-offset: 3px; }\n\n*:focus-visible {\n  outline: none;\n  box-shadow: var(--ring);\n  border-radius: var(--radius-xs);\n}\n\n<\u002Fstyle>\n<script src=\"60a3949c-72de-4e57-a20d-bc3a924cd111\"><\u002Fscript>\n<style>\n  body { margin: 0; background: #eeedf4; }\n  a { color: #2c48ed; text-decoration: none; }\n  a:hover { color: #2339c6; }\n<\u002Fstyle>\n\n<\u002Fhelmet>\n<div style=\"width: 2100px; background: #fafafb; font-family: Inter, system-ui, sans-serif; color: #001f54; padding: 56px 56px 48px; box-sizing: border-box;\">\n\n  <div style=\"display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; padding-bottom: 28px; border-bottom: 3px solid #001f54;\">\n    <div style=\"display: flex; flex-direction: column; gap: 14px;\">\n      <span style=\"font-size: 15px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #00806e;\">Cataract pathways<\u002Fspan>\n      <h1 style=\"margin: 0; font-family: Manrope, system-ui, sans-serif; font-size: 62px; line-height: 1.02; font-weight: 800; letter-spacing: -0.02em; color: #001f54;\">CES Medical pathways with Lutra Connect<\u002Fh1>\n      <p style=\"margin: 0; max-width: 1120px; font-size: 22px; line-height: 1.5; color: #3d4c6e; text-wrap: pretty;\">Overview of CES Medical's NHS and private pathways on Lutra Connect.<\u002Fp>\n    <\u002Fdiv>\n    <div style=\"display: flex; flex-direction: column; align-items: flex-end; gap: 18px; flex-shrink: 0;\">\n      <img src=\"5c49b051-ae3d-452f-9f6a-9b8dee310659\" alt=\"CES Medical\" style=\"height: 66px; width: auto;\">\n      <div style=\"display: flex; align-items: center; gap: 14px;\">\n        <span style=\"font-size: 14px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #5b688a;\">powered by<\u002Fspan>\n        <img src=\"63eab111-2bcc-4c95-af5d-b776d43ce659\" alt=\"Lutra Connect\" style=\"height: 34px; width: auto;\">\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n\n  <div style=\"display: grid; grid-template-columns: 220px 250px repeat(4, minmax(0, 1fr)); gap: 20px; margin-top: 30px; align-items: stretch;\">\n\n    <div style=\"display: flex; flex-direction: column; justify-content: center; gap: 14px; padding: 30px 24px; background: #001f54; border-radius: 20px;\">\n      <span style=\"font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #01c7a9;\">Pathway A<\u002Fspan>\n      <h2 style=\"margin: 0; font-family: Manrope, system-ui, sans-serif; font-size: 42px; line-height: 1.05; font-weight: 800; color: #ffffff;\">NHS<\u002Fh2>\n      <p style=\"margin: 0; font-size: 16px; line-height: 1.5; color: #c3cade;\">Post-op care is discharged out to community optometry and logged for payment through Lutra.<\u002Fp>\n    <\u002Fdiv>\n\n    <div style=\"display: flex; flex-direction: column; gap: 12px; padding: 24px 22px; background: #ffffff; border: 1px solid #dcdfe8; border-left: 5px solid #001f54; border-radius: 20px;\">\n      <span style=\"align-self: flex-start; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #001f54; background: #eeedf4; padding: 6px 12px; border-radius: 999px;\">Outside Lutra<\u002Fspan>\n      <h3 style=\"margin: 0; font-family: Manrope, system-ui, sans-serif; font-size: 21px; line-height: 1.15; font-weight: 800; color: #001f54;\">How NHS referrals are received<\u002Fh3>\n      <p style=\"margin: 0; font-size: 16px; line-height: 1.5; color: #3d4c6e;\">Referrals reach CES through the usual NHS route, so Rego or e-RS. No NHS referral comes in from optometry via Lutra.<\u002Fp>\n      <span style=\"font-size: 26px; line-height: 1; color: #01c7a9;\">→<\u002Fspan>\n    <\u002Fdiv>\n\n    <div style=\"display: flex; flex-direction: column; background: #ffffff; border: 1px solid #dcdfe8; border-radius: 20px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,31,84,0.06);\">\n      <div style=\"display: flex; align-items: center; gap: 12px; padding: 18px 22px; background: #eeedf4; border-bottom: 1px solid #dcdfe8;\">\n        <span style=\"display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 999px; background: #001f54; color: #ffffff; font-family: Manrope, system-ui, sans-serif; font-size: 17px; font-weight: 800;\">1<\u002Fspan>\n        <h3 style=\"margin: 0; font-family: Manrope, system-ui, sans-serif; font-size: 25px; font-weight: 800; letter-spacing: -0.01em; color: #001f54;\">Referral<\u002Fh3>\n      <\u002Fdiv>\n      <div style=\"display: flex; flex-direction: column; gap: 14px; padding: 20px 22px 22px;\">\n        <span style=\"align-self: flex-start; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #2c48ed; background: #edefff; padding: 6px 12px; border-radius: 999px;\">CES Medical<\u002Fspan>\n        <p style=\"margin: 0; font-size: 17px; line-height: 1.5; color: #001f54;\">The booking team adds the referral to Lutra as a self-referral, then accepts it on behalf of CES.<\u002Fp>\n        <p style=\"margin: 0; font-size: 17px; line-height: 1.5; color: #3d4c6e;\">The AI assistant reads the referral letter and fills in the details, so nobody retypes the whole record.<\u002Fp>\n        <p style=\"margin: 0; font-size: 17px; line-height: 1.5; color: #3d4c6e;\">The pre-op questionnaire goes out to the patient at this point, with videos, PDF literature and a lens choice question.<\u002Fp>\n        <div style=\"background: #ffffff; border: 1px solid #dcdfe8; border-radius: 12px; overflow: hidden;\">\n          <img src=\"cf667e80-de29-47f6-a2e0-c69e63306e75\" alt=\"Recipient organisation field on a Lutra referral\" style=\"width: 100%; height: auto; display: block;\">\n        <\u002Fdiv>\n        <div style=\"display: flex; flex-direction: column; gap: 10px; padding: 14px 16px; background: #faf7ff; border: 1px solid #d9c7f5; border-radius: 12px;\">\n          <span style=\"font-size: 15px; font-weight: 700; color: #5b1fb8;\">Start from a document · AI Assistant<\u002Fspan>\n          <span style=\"font-size: 15px; line-height: 1.4; color: #3d4c6e;\">Upload a referral letter or document and let the AI assistant fill in the details.<\u002Fspan>\n          <img src=\"46c41444-7fef-471d-b40e-ac3e05fe0792\" alt=\"Start from a document, AI assistant banner in Lutra\" style=\"width: 100%; height: auto; display: block; border-radius: 6px;\">\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n\n    <div style=\"display: flex; flex-direction: column; background: #ffffff; border: 1px solid #dcdfe8; border-radius: 20px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,31,84,0.06);\">\n      <div style=\"display: flex; align-items: center; gap: 12px; padding: 18px 22px; background: #eeedf4; border-bottom: 1px solid #dcdfe8;\">\n        <span style=\"display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 999px; background: #001f54; color: #ffffff; font-family: Manrope, system-ui, sans-serif; font-size: 17px; font-weight: 800;\">2<\u002Fspan>\n        <h3 style=\"margin: 0; font-family: Manrope, system-ui, sans-serif; font-size: 25px; font-weight: 800; letter-spacing: -0.01em; color: #001f54;\">Consultation<\u002Fh3>\n      <\u002Fdiv>\n      <div style=\"display: flex; flex-direction: column; gap: 14px; padding: 20px 22px 22px;\">\n        <span style=\"align-self: flex-start; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #2c48ed; background: #edefff; padding: 6px 12px; border-radius: 999px;\">CES Medical<\u002Fspan>\n        <p style=\"margin: 0; font-size: 17px; line-height: 1.5; color: #001f54;\">Pre-assessment findings are recorded here and can be shared with the referring optometrist.<\u002Fp>\n        <p style=\"margin: 0; font-size: 17px; line-height: 1.5; color: #3d4c6e;\">This is also where a patient is closed or discharged in Lutra, which feeds the RTT closed calculation.<\u002Fp>\n        <div style=\"background: #ffffff; border: 1px solid #dcdfe8; border-radius: 12px; overflow: hidden;\">\n          <img src=\"915729c4-6661-48d0-8dc3-b85f2114533a\" alt=\"Consultation next steps in Lutra\" style=\"width: 100%; height: auto; display: block;\">\n        <\u002Fdiv>\n        <div style=\"display: flex; align-items: center; gap: 10px; padding: 12px 14px; background: #e6faf6; border-radius: 12px;\">\n          <span style=\"font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #00806e;\">RTT<\u002Fspan>\n          <span style=\"font-size: 15px; line-height: 1.4; color: #00473c;\">Discharge here counts as a closed pathway.<\u002Fspan>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n\n    <div style=\"display: flex; flex-direction: column; background: #ffffff; border: 1px solid #dcdfe8; border-radius: 20px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,31,84,0.06);\">\n      <div style=\"display: flex; align-items: center; gap: 12px; padding: 18px 22px; background: #eeedf4; border-bottom: 1px solid #dcdfe8;\">\n        <span style=\"display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 999px; background: #001f54; color: #ffffff; font-family: Manrope, system-ui, sans-serif; font-size: 17px; font-weight: 800;\">3<\u002Fspan>\n        <h3 style=\"margin: 0; font-family: Manrope, system-ui, sans-serif; font-size: 25px; font-weight: 800; letter-spacing: -0.01em; color: #001f54;\">Surgical stage<\u002Fh3>\n      <\u002Fdiv>\n      <div style=\"display: flex; flex-direction: column; gap: 14px; padding: 20px 22px 22px;\">\n        <span style=\"align-self: flex-start; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #2c48ed; background: #edefff; padding: 6px 12px; border-radius: 999px;\">CES Medical<\u002Fspan>\n        <p style=\"margin: 0; font-size: 17px; line-height: 1.5; color: #001f54;\">The surgical note or letter is added for the optometrist to review: prescribed medicine, lens type and any complications.<\u002Fp>\n        <p style=\"margin: 0; font-size: 17px; line-height: 1.5; color: #3d4c6e;\">The surgery date is entered here, which is the date the RTT calculations run from.<\u002Fp>\n        <div style=\"background: #ffffff; border: 1px solid #dcdfe8; border-radius: 12px; overflow: hidden;\">\n          <img src=\"53d06913-d1ef-4f95-9644-17baae3d8aac\" alt=\"Surgical stages table in Lutra\" style=\"width: 100%; height: auto; display: block;\">\n        <\u002Fdiv>\n        <div style=\"display: flex; align-items: center; gap: 10px; padding: 12px 14px; background: #e6faf6; border-radius: 12px;\">\n          <span style=\"font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #00806e;\">RTT<\u002Fspan>\n          <span style=\"font-size: 15px; line-height: 1.4; color: #00473c;\">Surgery date drives the reporting.<\u002Fspan>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n\n    <div style=\"display: flex; flex-direction: column; background: #ffffff; border: 1px solid #001f54; border-radius: 20px; overflow: hidden; box-shadow: 0 6px 20px rgba(0,31,84,0.12);\">\n      <div style=\"display: flex; align-items: center; gap: 12px; padding: 18px 22px; background: #001f54;\">\n        <span style=\"display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 999px; background: #01c7a9; color: #001f54; font-family: Manrope, system-ui, sans-serif; font-size: 17px; font-weight: 800;\">4<\u002Fspan>\n        <h3 style=\"margin: 0; font-family: Manrope, system-ui, sans-serif; font-size: 25px; font-weight: 800; letter-spacing: -0.01em; color: #ffffff;\">Post-op assessment<\u002Fh3>\n      <\u002Fdiv>\n      <div style=\"display: flex; flex-direction: column; gap: 14px; padding: 20px 22px 22px;\">\n        <span style=\"align-self: flex-start; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #00806e; background: #e6faf6; padding: 6px 12px; border-radius: 999px;\">Community optometrist<\u002Fspan>\n        <p style=\"margin: 0; font-size: 17px; line-height: 1.5; color: #001f54;\">The aim is for every NHS patient to be discharged to optometry, so the optometrist completes the post-op assessment in Lutra.<\u002Fp>\n        <p style=\"margin: 0; font-size: 17px; line-height: 1.5; color: #3d4c6e;\">A CES admin then approves it, checking the assessment was done properly and the data is right.<\u002Fp>\n        <p style=\"margin: 0; font-size: 17px; line-height: 1.5; color: #3d4c6e;\">Once approved, the post-op is registered against that practice and appears on their monthly invoice, which Lutra generates automatically. Payment stays between CES and the practice.<\u002Fp>\n        <div style=\"background: #ffffff; border: 1px solid #dcdfe8; border-radius: 12px; overflow: hidden;\">\n          <img src=\"2f180ad4-0f34-4fea-9fbd-fb4ba7fb32d8\" alt=\"Post-op assessment in Lutra\" style=\"width: 100%; height: auto; display: block;\">\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n\n  <div style=\"display: grid; grid-template-columns: 220px 250px repeat(4, minmax(0, 1fr)); gap: 20px; margin-top: 26px; align-items: stretch;\">\n\n    <div style=\"display: flex; flex-direction: column; justify-content: center; gap: 14px; padding: 30px 24px; background: #ffffff; border: 2px solid #01c7a9; border-radius: 20px;\">\n      <span style=\"font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #00806e;\">Pathway B<\u002Fspan>\n      <h2 style=\"margin: 0; font-family: Manrope, system-ui, sans-serif; font-size: 42px; line-height: 1.05; font-weight: 800; color: #001f54;\">Private<\u002Fh2>\n      <p style=\"margin: 0; font-size: 16px; line-height: 1.5; color: #3d4c6e;\">Optometrists refer straight into Lutra and CES keeps the patient through to post-op.<\u002Fp>\n    <\u002Fdiv>\n\n    <div style=\"display: flex; flex-direction: column; gap: 12px; padding: 24px 22px; background: #ffffff; border: 1px dashed #01c7a9; border-radius: 20px;\">\n      <span style=\"align-self: flex-start; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #00806e; background: #e6faf6; padding: 6px 12px; border-radius: 999px;\">Optional<\u002Fspan>\n      <h3 style=\"margin: 0; font-family: Manrope, system-ui, sans-serif; font-size: 21px; line-height: 1.15; font-weight: 800; color: #001f54;\">Advice &amp; Guidance<\u002Fh3>\n      <p style=\"margin: 0; font-size: 16px; line-height: 1.5; color: #3d4c6e;\">An optometrist can raise an Advice &amp; Guidance request with CES Medical in Lutra before referring, and take the answer back to the patient.<\u002Fp>\n      <span style=\"font-size: 26px; line-height: 1; color: #01c7a9;\">→<\u002Fspan>\n    <\u002Fdiv>\n\n    <div style=\"display: flex; flex-direction: column; background: #ffffff; border: 1px solid #dcdfe8; border-radius: 20px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,31,84,0.06);\">\n      <div style=\"display: flex; align-items: center; gap: 12px; padding: 18px 22px; background: #e6faf6; border-bottom: 1px solid #c2eee6;\">\n        <span style=\"display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 999px; background: #01c7a9; color: #001f54; font-family: Manrope, system-ui, sans-serif; font-size: 17px; font-weight: 800;\">1<\u002Fspan>\n        <h3 style=\"margin: 0; font-family: Manrope, system-ui, sans-serif; font-size: 25px; font-weight: 800; letter-spacing: -0.01em; color: #001f54;\">Referral<\u002Fh3>\n      <\u002Fdiv>\n      <div style=\"display: flex; flex-direction: column; gap: 14px; padding: 20px 22px 22px;\">\n        <span style=\"align-self: flex-start; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #00806e; background: #e6faf6; padding: 6px 12px; border-radius: 999px;\">Referring optometrist<\u002Fspan>\n        <p style=\"margin: 0; font-size: 17px; line-height: 1.5; color: #001f54;\">Optometrists refer to CES Medical in Lutra, so the referral arrives complete and the practice keeps sight of the patient.<\u002Fp>\n        <p style=\"margin: 0; font-size: 17px; line-height: 1.5; color: #3d4c6e;\">The pre-op questionnaire goes out to the patient at this point, with videos, PDF literature and a lens choice question.<\u002Fp>\n        <div style=\"background: #ffffff; border: 1px solid #dcdfe8; border-radius: 12px; overflow: hidden;\">\n          <img src=\"cf667e80-de29-47f6-a2e0-c69e63306e75\" alt=\"Recipient organisation field on a Lutra referral\" style=\"width: 100%; height: auto; display: block;\">\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n\n    <div style=\"display: flex; flex-direction: column; background: #ffffff; border: 1px solid #dcdfe8; border-radius: 20px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,31,84,0.06);\">\n      <div style=\"display: flex; align-items: center; gap: 12px; padding: 18px 22px; background: #e6faf6; border-bottom: 1px solid #c2eee6;\">\n        <span style=\"display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 999px; background: #01c7a9; color: #001f54; font-family: Manrope, system-ui, sans-serif; font-size: 17px; font-weight: 800;\">2<\u002Fspan>\n        <h3 style=\"margin: 0; font-family: Manrope, system-ui, sans-serif; font-size: 25px; font-weight: 800; letter-spacing: -0.01em; color: #001f54;\">Consultation<\u002Fh3>\n      <\u002Fdiv>\n      <div style=\"display: flex; flex-direction: column; gap: 14px; padding: 20px 22px 22px;\">\n        <span style=\"align-self: flex-start; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #2c48ed; background: #edefff; padding: 6px 12px; border-radius: 999px;\">CES Medical<\u002Fspan>\n        <p style=\"margin: 0; font-size: 17px; line-height: 1.5; color: #001f54;\">Same as the NHS pathway. Pre-assessment notes can be shared with the referring optometrist.<\u002Fp>\n        <p style=\"margin: 0; font-size: 17px; line-height: 1.5; color: #3d4c6e;\">Closing or discharging a patient happens here and feeds the RTT closed calculation.<\u002Fp>\n        <div style=\"display: flex; align-items: center; gap: 10px; padding: 14px 16px; background: #f4f5f8; border-radius: 12px;\">\n          <span style=\"font-size: 15px; line-height: 1.4; color: #3d4c6e;\">Identical screen to pathway A, stage 2.<\u002Fspan>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n\n    <div style=\"display: flex; flex-direction: column; background: #ffffff; border: 1px solid #dcdfe8; border-radius: 20px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,31,84,0.06);\">\n      <div style=\"display: flex; align-items: center; gap: 12px; padding: 18px 22px; background: #e6faf6; border-bottom: 1px solid #c2eee6;\">\n        <span style=\"display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 999px; background: #01c7a9; color: #001f54; font-family: Manrope, system-ui, sans-serif; font-size: 17px; font-weight: 800;\">3<\u002Fspan>\n        <h3 style=\"margin: 0; font-family: Manrope, system-ui, sans-serif; font-size: 25px; font-weight: 800; letter-spacing: -0.01em; color: #001f54;\">Surgical stage<\u002Fh3>\n      <\u002Fdiv>\n      <div style=\"display: flex; flex-direction: column; gap: 14px; padding: 20px 22px 22px;\">\n        <span style=\"align-self: flex-start; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #2c48ed; background: #edefff; padding: 6px 12px; border-radius: 999px;\">CES Medical<\u002Fspan>\n        <p style=\"margin: 0; font-size: 17px; line-height: 1.5; color: #001f54;\">Surgical notes and letters are added for the optometrist to review, covering prescribed medicine, lens type and complications.<\u002Fp>\n        <p style=\"margin: 0; font-size: 17px; line-height: 1.5; color: #3d4c6e;\">The surgery date is entered here and drives the RTT calculations.<\u002Fp>\n        <div style=\"background: #ffffff; border: 1px solid #dcdfe8; border-radius: 12px; overflow: hidden;\">\n          <img src=\"53d06913-d1ef-4f95-9644-17baae3d8aac\" alt=\"Surgical stages table in Lutra\" style=\"width: 100%; height: auto; display: block;\">\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n\n    <div style=\"display: flex; flex-direction: column; background: #ffffff; border: 2px solid #01c7a9; border-radius: 20px; overflow: hidden; box-shadow: 0 6px 20px rgba(1,199,169,0.16);\">\n      <div style=\"display: flex; align-items: center; gap: 12px; padding: 18px 22px; background: #01c7a9;\">\n        <span style=\"display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 999px; background: #001f54; color: #ffffff; font-family: Manrope, system-ui, sans-serif; font-size: 17px; font-weight: 800;\">4<\u002Fspan>\n        <h3 style=\"margin: 0; font-family: Manrope, system-ui, sans-serif; font-size: 25px; font-weight: 800; letter-spacing: -0.01em; color: #001f54;\">Post-op assessment<\u002Fh3>\n      <\u002Fdiv>\n      <div style=\"display: flex; flex-direction: column; gap: 14px; padding: 20px 22px 22px;\">\n        <span style=\"align-self: flex-start; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #2c48ed; background: #edefff; padding: 6px 12px; border-radius: 999px;\">CES Medical<\u002Fspan>\n        <p style=\"margin: 0; font-size: 17px; line-height: 1.5; color: #001f54;\">Private post-ops are done at CES Medical rather than in community optometry, so there is no optometry approval or invoice step.<\u002Fp>\n        <p style=\"margin: 0; font-size: 17px; line-height: 1.5; color: #3d4c6e;\">If you want the referring optometrist to know the outcome, upload the post-op letter to Lutra and it appears on their record of the patient.<\u002Fp>\n        <div style=\"display: flex; align-items: center; gap: 12px; padding: 14px 16px; background: #001f54; border-radius: 12px;\">\n          <span style=\"font-size: 15px; line-height: 1.4; color: #ffffff;\">Difference from NHS: no post-op invoice is raised.<\u002Fspan>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n\n  <div style=\"display: grid; grid-template-columns: 220px minmax(0, 1fr) 300px; gap: 20px; margin-top: 26px; padding: 26px 30px; background: #ffffff; border: 1px solid #dcdfe8; border-radius: 20px; align-items: center;\">\n    <div style=\"display: flex; flex-direction: column; gap: 10px;\">\n      <span style=\"font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #00806e;\">Both pathways<\u002Fspan>\n      <h2 style=\"margin: 0; font-family: Manrope, system-ui, sans-serif; font-size: 34px; line-height: 1.05; font-weight: 800; color: #001f54;\">Status<\u002Fh2>\n    <\u002Fdiv>\n    <div style=\"display: flex; flex-direction: column; gap: 14px;\">\n      <p style=\"margin: 0; font-size: 19px; line-height: 1.5; color: #001f54; max-width: 1000px;\">Separate from the four stages, CES can update the status of a patient's pathway at any point. It gives referring optometrists an at-a-glance answer on where their patient has got to, without anyone having to ring the booking team.<\u002Fp>\n      <div style=\"display: flex; flex-wrap: wrap; gap: 10px;\">\n        <span style=\"font-size: 15px; font-weight: 600; color: #001f54; background: #eeedf4; padding: 8px 16px; border-radius: 999px;\">Awaiting patient<\u002Fspan>\n        <span style=\"font-size: 15px; font-weight: 600; color: #001f54; background: #eeedf4; padding: 8px 16px; border-radius: 999px;\">Patient not interested<\u002Fspan>\n        <span style=\"font-size: 15px; font-weight: 600; color: #001f54; background: #eeedf4; padding: 8px 16px; border-radius: 999px;\">Consultation booked<\u002Fspan>\n        <span style=\"font-size: 15px; font-weight: 600; color: #001f54; background: #eeedf4; padding: 8px 16px; border-radius: 999px;\">Pending surgery<\u002Fspan>\n        <span style=\"font-size: 15px; font-weight: 600; color: #001f54; background: #eeedf4; padding: 8px 16px; border-radius: 999px;\">Surgery booked<\u002Fspan>\n        <span style=\"font-size: 15px; font-weight: 600; color: #ffffff; background: #001f54; padding: 8px 16px; border-radius: 999px;\">Surgery completed<\u002Fspan>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"background: #ffffff; border: 1px solid #dcdfe8; border-radius: 12px; overflow: hidden;\">\n      <img src=\"79ccf60a-7084-4dae-bb5a-bd15354d0b7b\" alt=\"Status menu in Lutra\" style=\"width: 100%; height: auto; display: block;\">\n    <\u002Fdiv>\n  <\u002Fdiv>\n\n  <div style=\"display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: 28px;\">\n    <span style=\"font-size: 15px; color: #5b688a;\">CES Medical cataract pathways on Lutra Connect · September 2026<\u002Fspan>\n    <img src=\"79921185-3446-4449-8929-ec8786377e16\" alt=\"\" style=\"height: 22px; width: auto; opacity: 0.7;\">\n  <\u002Fdiv>\n<\u002Fdiv>\n\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;$preview&quot;:{&quot;width&quot;:2100,&quot;height&quot;:1800}}\"><\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
